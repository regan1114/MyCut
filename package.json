{
  "name": "mycut",
  "version": "0.6.11",
  "private": true,
  "type": "module",
  "description": "MyCut — 本機多軌影片剪輯器",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 127.0.0.1\"",
    "build": "tsc --noEmit && vite build && esbuild server/index.ts --bundle --platform=node --format=esm --packages=external --outfile=dist-server/index.mjs",
    "start": "node dist-server/index.mjs",
    "desktop": "npm run build && electron .",
    "package:mac": "node scripts/package-desktop.mjs mac",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:export": "node --import tsx scripts/verify-export.ts",
    "test:hour": "node --import tsx scripts/verify-hour.ts",
    "test:ui": "playwright test",
    "fonts:install": "node scripts/install-fonts.mjs",
    "typecheck": "tsc --noEmit",
    "test:speech": "node --import tsx scripts/verify-speech.ts",
    "speech:install": "node scripts/install-speech.mjs",
    "test:effects": "node --import tsx scripts/verify-effects.ts",
    "test:effects:hour": "node --import tsx scripts/verify-hour.ts --effects",
    "test:karaoke": "node --import tsx scripts/verify-karaoke.ts",
    "test:expanded:hour": "node --import tsx scripts/verify-hour.ts --expanded",
    "art:build": "node --import tsx scripts/generate-library-art.ts",
    "package:win": "node scripts/package-desktop.mjs win",
    "speech:install:win": "node scripts/install-speech.mjs --platform win32",
    "test:desktop": "node scripts/verify-desktop.mjs",
    "package:mac:arm64": "node scripts/package-desktop.mjs mac --arch arm64",
    "package:mac:x64": "node scripts/package-desktop.mjs mac --arch x64",
    "test:workflow": "node --import tsx scripts/verify-workflow.ts",
    "test:portable:desktop": "node scripts/verify-portable-desktop.mjs",
    "test:close:desktop": "node scripts/verify-close-editor.mjs",
    "test:fonts:desktop": "node scripts/verify-fonts-desktop.mjs",
    "test:interface:desktop": "node scripts/verify-interface-desktop.mjs"
  },
  "dependencies": {
    "@napi-rs/canvas": "^1.0.9",
    "@resvg/resvg-js": "^2.6.2",
    "busboy": "^1.6.0",
    "express": "^5.1.0",
    "ffmpeg-static": "^5.2.0",
    "ffprobe-static": "^3.1.0",
    "lucide-react": "^0.468.0",
    "opencc-js": "^1.4.2",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.51.0",
    "@types/busboy": "^1.5.4",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "7zip-bin": "5.2.0",
    "concurrently": "^9.1.0",
    "electron": "^41.0.0",
    "electron-builder": "^26.0.0",
    "esbuild": "^0.25.0",
    "resedit": "1.7.2",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.1.0"
  },
  "build": {
    "appId": "studio.mycut.desktop",
    "productName": "MyCut",
    "files": [
      "dist/**/*",
      "!dist/fonts/**/*",
      "dist-server/**/*",
      "electron/**/*",
      "public/fonts/**/*",
      "THIRD_PARTY_NOTICES.md",
      "package.json",
      "resources/speech/**/*"
    ],
    "asarUnpack": [
      "public/fonts/**/*",
      "node_modules/ffmpeg-static/**/*",
      "node_modules/ffprobe-static/**/*",
      "node_modules/@resvg/**/*",
      "resources/speech/**/*",
      "node_modules/@napi-rs/**/*",
      "node_modules/@ffprobe-installer/**/*"
    ],
    "mac": {
      "category": "public.app-category.video",
      "target": [
        "dir"
      ],
      "icon": "resources/icon.icns",
      "extendInfo": {
        "NSMicrophoneUsageDescription": "MyCut 使用麥克風錄製旁白，錄音只會儲存在你的 Mac。"
      },
      "minimumSystemVersion": "14.0",
      "identity": "-"
    },
    "directories": {
      "output": "release"
    },
    "win": {
      "icon": "resources/icon.ico",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64"
          ]
        }
      ],
      "artifactName": "MyCut-${version}-Windows-${arch}.${ext}",
      "signExecutable": false,
      "extraFiles": [
        {
          "from": "resources/windows-runtime/x64",
          "to": ".",
          "filter": [
            "*.dll",
            "NOTICE.txt",
            "manifest.json"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "MyCut",
      "artifactName": "MyCut-${version}-Windows-${arch}-Setup.${ext}",
      "installerLanguages": [
        "zh_TW",
        "en_US"
      ],
      "language": "1028"
    },
    "compression": "normal"
  },
  "optionalDependencies": {
    "@ffprobe-installer/darwin-arm64": "5.0.1"
  }
}
